# Configuración del Servidor
PORT=8080
NODE_ENV=development
CLUSTER_WORKERS=2
MAINTENANCE=false

# Base de Datos (Base local por defecto o formato de Mongo Atlas)
URI_MONGO_CONNECT=mongodb://localhost:27017/mi_base_de_datos
SEED_DB=false

# Autenticación y Seguridad
JWT_SECRET=tu_secreto_seguro_para_jwt
JWT_EXPIRES_IN=24h
COOKIE_SECRET=tu_secreto_para_cookies

# OAuth - GitHub
GITHUB_CLIENT_ID=tu_client_id_de_github
GITHUB_CLIENT_SECRET=tu_client_secret_de_github

# Configuración de Emails (Nodemailer / Gmail)
USER_G=tu_correo@gmail.com
MAIL_APP=tu_contraseña_de_aplicacion_de_gmail

# Credenciales de Administrador por defecto
ADMIN_USER=admin@tienda.com
ADMIN_PASS=ContraAdmin123!NOFAKE

# Configuración de la App
Tienda=nombreDeTuTienda